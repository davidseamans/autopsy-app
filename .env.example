VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel Function configuration. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ABR_AUTHENTICATION_GUID=

# Test mode only. This build rejects any key that does not begin sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOPSY_PRICE_ID=price_replace_me
APP_BASE_URL=http://localhost:8080

# QBO sandbox/read-only connection. Server-only: never prefix with VITE_.
# Production QBO is deliberately rejected by the runtime guard.
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8080/api/qbo/callback
# Base64-encoded 32-byte key used for AES-256-GCM token encryption.
QBO_TOKEN_ENCRYPTION_KEY=

# FWC MAPD — Cleaning Sleeve source data only. Server-only; never prefix with VITE_.
FWC_MAPD_BASE_URL=https://api.fwc.gov.au/api/v1
FWC_MAPD_SUBSCRIPTION_KEY=
